# OpenAI-compatible API used by all analysis agents.
# The selected model must support tool/function calling.
OPENAI_COMPATIBLE_API_KEY=replace_with_your_key
OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
OPENAI_COMPATIBLE_MODEL=tool_calling_model_name

# Use "api" for the first deployment. Only Summary Agent supports "local".
USE_LOCAL_MODEL=api

